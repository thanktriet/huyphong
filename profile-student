<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ Sơ Học Viên</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="config.js"></script>
    <script src="auth.js"></script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .tab-active { background-color: #2563eb; color: white; border-color: #2563eb; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3); }
        .bar-fill { transition: width 1s ease-out; }
    </style>
</head>
<body class="bg-slate-50 pb-10 font-sans text-slate-800">

    <div class="bg-white p-4 sticky top-0 z-20 shadow-sm flex items-center gap-3 border-b border-slate-100">
        <button onclick="history.back()" class="p-2 hover:bg-slate-100 rounded-full transition-colors">
            <i data-lucide="arrow-left" class="w-6 h-6 text-slate-600"></i>
        </button>
        <h1 class="text-lg font-bold text-slate-900">Chi Tiết Học Viên</h1>
    </div>

    <div class="max-w-2xl mx-auto px-4 mt-6 space-y-6">

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4 relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-10"><i data-lucide="user" class="w-24 h-24 text-blue-600"></i></div>
            <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-2xl font-bold shadow-inner" id="st-avt">...</div>
            <div class="relative z-10">
                <h2 class="text-2xl font-bold text-slate-900" id="st-name">Đang tải...</h2>
                <p class="text-sm text-slate-500" id="st-email">...</p>
                <div class="flex gap-2 mt-2">
                    <span class="text-xs font-bold bg-blue-50 text-blue-600 px-2 py-1 rounded border border-blue-100" id="st-session">- Buổi</span>
                    <span class="text-xs font-bold bg-green-50 text-green-600 px-2 py-1 rounded border border-green-100" id="st-expiry">...</span>
                </div>
            </div>
        </div>

        <div class="flex bg-white p-1.5 rounded-xl shadow-sm border border-slate-200">
            <button onclick="switchTab('workout', this)" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all tab-active">Lịch Sử Tập</button>
            <button onclick="switchTab('nutrition', this)" class="flex-1 py-2 text-xs font-bold rounded-lg text-slate-500 hover:bg-slate-50 transition-all">Dinh Dưỡng</button>
            <button onclick="switchTab('body', this)" class="flex-1 py-2 text-xs font-bold rounded-lg text-slate-500 hover:bg-slate-50 transition-all">Cơ Thể</button>
        </div>

        <div id="view-workout" class="view-section space-y-4">
            <div id="workout-list" class="space-y-3">
                <p class="text-center text-slate-400 py-10">Đang tải dữ liệu...</p>
            </div>
        </div>

        <div id="view-nutrition" class="view-section hidden space-y-4">
            <div id="nutrition-list" class="space-y-3"></div>
        </div>

        <div id="view-body" class="view-section hidden space-y-4">
            <div id="body-list" class="space-y-3"></div>
        </div>

    </div>

    <script>
        lucide.createIcons();
        
        // Lấy ID từ URL (ví dụ: profile-student.html?id=U_12345)
        const urlParams = new URLSearchParams(window.location.search);
        const studentId = urlParams.get('id');

        // Kiểm tra quyền Admin
        const adminUser = JSON.parse(localStorage.getItem('pt_user'));
        if (!adminUser || adminUser.role !== 'PT') {
            alert("Bạn không có quyền truy cập!");
            window.location.href = 'login.html';
        }

        if (!studentId) {
            alert("Không tìm thấy học viên!");
            history.back();
        }

        // START
        init();

        async function init() {
            await loadStudentInfo();
            await Promise.all([loadWorkoutHistory(), loadNutritionHistory(), loadBodyHistory()]);
        }

        // 1. LẤY THÔNG TIN CƠ BẢN
        async function loadStudentInfo() {
            const res = await callAPI('get_all_students'); // Lấy list về lọc (hoặc viết API get_user_info riêng nếu muốn tối ưu hơn)
            if(res.success) {
                const student = res.data.find(s => s.id === studentId);
                if (student) {
                    document.getElementById('st-name').innerText = student.name;
                    document.getElementById('st-email').innerText = student.email;
                    document.getElementById('st-avt').innerText = student.name.charAt(0).toUpperCase();
                    document.getElementById('st-session').innerText = `${student.sessionLeft} Buổi`;
                    document.getElementById('st-expiry').innerText = student.isExpired ? "Hết hạn" : `Hạn: ${student.expiryDate}`;
                }
            }
        }

        // 2. LỊCH SỬ TẬP
        async function loadWorkoutHistory() {
            const res = await callAPI('get_workout_history', { userId: studentId });
            const list = document.getElementById('workout-list');
            
            if(res.success && Object.keys(res.data).length > 0) {
                const dates = Object.keys(res.data).sort((a,b) => new Date(b.split('/').reverse().join('-')) - new Date(a.split('/').reverse().join('-')));
                list.innerHTML = dates.map(date => {
                    const logs = res.data[date];
                    return `
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="bg-slate-50 px-4 py-2 border-b border-slate-100 flex justify-between items-center">
                            <span class="font-bold text-slate-700 text-sm flex items-center gap-2"><i data-lucide="calendar" class="w-4 h-4 text-blue-500"></i> ${date}</span>
                            <span class="text-xs text-slate-500 bg-white border px-2 py-0.5 rounded-full font-medium">${logs.length} bài</span>
                        </div>
                        <div class="divide-y divide-slate-50">
                            ${logs.map(l => `
                                <div class="p-3 flex justify-between items-center text-sm hover:bg-slate-50">
                                    <span class="font-medium text-slate-700">${l.exercise}</span>
                                    <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-xs font-bold border border-blue-100">${l.weight}kg x ${l.reps}</span>
                                </div>`).join('')}
                        </div>
                    </div>`;
                }).join('');
                lucide.createIcons();
            } else {
                list.innerHTML = '<div class="text-center py-10 text-slate-400">Chưa có dữ liệu tập luyện.</div>';
            }
        }

        // 3. LỊCH SỬ ĂN
        async function loadNutritionHistory() {
            const res = await callAPI('get_nutrition_history', { userId: studentId });
            const list = document.getElementById('nutrition-list');
            
            if(res.success && Object.keys(res.data).length > 0) {
                const dates = Object.keys(res.data).sort((a,b) => new Date(b).getTime() - new Date(a).getTime());
                list.innerHTML = dates.map(date => {
                    const d = res.data[date];
                    const displayDate = date.split('-').reverse().join('/');
                    const percent = Math.min((d.cal / 2000) * 100, 100);
                    
                    return `
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="font-bold text-sm text-slate-700">${displayDate}</span>
                            <span class="text-xs font-bold text-slate-500">${Math.round(d.cal)} kcal</span>
                        </div>
                        <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-3">
                            <div class="h-full bg-green-500 bar-fill" style="width: ${percent}%"></div>
                        </div>
                        <div class="flex justify-between text-xs text-slate-500 px-2">
                            <span>Pro: <b class="text-red-500">${Math.round(d.pro)}g</b></span>
                            <span>Carb: <b class="text-orange-500">${Math.round(d.carb)}g</b></span>
                            <span>Fat: <b class="text-yellow-500">${Math.round(d.fat)}g</b></span>
                        </div>
                    </div>`;
                }).join('');
            } else {
                list.innerHTML = '<div class="text-center py-10 text-slate-400">Chưa có dữ liệu ăn uống.</div>';
            }
        }

        // 4. LỊCH SỬ CÂN NẶNG
        async function loadBodyHistory() {
            const res = await callAPI('get_body_history', { userId: studentId });
            const list = document.getElementById('body-list');
            
            if(res.success && res.data.length > 0) {
                const sorted = res.data.reverse();
                list.innerHTML = sorted.map((b, i) => {
                    const dateParts = b.date.split('-'); 
                    const displayDate = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;
                    const change = i < sorted.length - 1 ? (b.weight - sorted[i+1].weight).toFixed(1) : 0;
                    const color = change < 0 ? 'text-green-600' : (change > 0 ? 'text-red-500' : 'text-slate-400');
                    const sign = change > 0 ? '+' : '';

                    return `
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="bg-slate-50 p-2 rounded-lg text-slate-400"><i data-lucide="scale" class="w-5 h-5"></i></div>
                            <div>
                                <div class="font-bold text-slate-800 text-lg">${b.weight} kg</div>
                                <div class="text-xs text-slate-400">${displayDate}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-bold ${color}">${sign}${change} kg</div>
                            <div class="text-[10px] text-slate-400 uppercase">Thay đổi</div>
                        </div>
                    </div>`;
                }).join('');
                lucide.createIcons();
            } else {
                list.innerHTML = '<div class="text-center py-10 text-slate-400">Chưa có số đo.</div>';
            }
        }

        // UI UTILS
        function switchTab(name, btn) {
            document.querySelectorAll('.view-section').forEach(e => e.classList.add('hidden'));
            document.getElementById(`view-${name}`).classList.remove('hidden');
            document.querySelectorAll('button').forEach(b => {
                if(b.parentElement.classList.contains('flex')) { // Chỉ target nút trong tab
                    b.className = 'flex-1 py-2 text-xs font-bold rounded-lg text-slate-500 hover:bg-slate-50 transition-all';
                }
            });
            btn.className = 'flex-1 py-2 text-xs font-bold rounded-lg transition-all tab-active';
        }
    </script>
</body>
</html>
